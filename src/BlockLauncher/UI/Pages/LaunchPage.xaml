<UserControl x:Class="BlockLauncher.UI.Pages.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 黄历的一行：上面是「做什么」，下面是「会怎样」 -->
        <DataTemplate x:Key="AlmanacRow">
            <StackPanel Margin="0,0,0,9">
                <TextBlock Text="{Binding Title}" FontSize="12.8" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Text}" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,14,24,18">

            <!-- ===== 主视觉：账号 + 启动 ===== -->
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="66" Height="66" CornerRadius="18" Background="{DynamicResource AccentSoft}" ClipToBounds="True"
                                VerticalAlignment="Center" BorderBrush="#66FFFFFF" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="AvatarFallback" Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="28" Foreground="{DynamicResource Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="Avatar" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                            <TextBlock x:Name="PlayerName" Text="未登录" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="AccountType" Text="点击下方添加账号" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource Ghost}" Margin="4,0,0,0" Padding="6,2" Click="Accounts_Click" ToolTip="切换 / 管理账号">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,5,0"/>
                                        <TextBlock Text="切换 / 管理账号" FontSize="11.5"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="LaunchButton" Grid.Column="2" Style="{StaticResource Primary}" Height="54" MinWidth="200" Padding="28,0"
                                VerticalAlignment="Center" Click="Launch_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="LaunchText" Text="启动游戏" FontSize="15.5" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                                <TextBlock x:Name="LaunchSub" Text="未选择版本" FontSize="10.5" HorizontalAlignment="Center" Foreground="#CCFFFFFF" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 启动进度 -->
                    <StackPanel x:Name="LaunchProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="LaunchStep" Text="正在启动…" Style="{StaticResource Body}" HorizontalAlignment="Left"/>
                        <ProgressBar x:Name="LaunchBar" Maximum="1" Margin="0,8,0,8"/>
                        <Button Content="取消启动" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Click="CancelLaunch_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="版本选择" Click="Versions_Click"/>
                        <Button Content="版本设置" Margin="8,0,0,0" Click="VersionSettings_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 欢迎 / 最新版本 ===== -->
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <TextBlock x:Name="Greeting" Text="欢迎回来" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Body}" Text="点右边的“启动游戏”就能开玩。没有版本？去「下载」页装一个，原版、Forge、NeoForge、Fabric、Quilt 都能一键装。"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="LatestRelease" Style="{StaticResource Primary}" Margin="0,0,8,8" Click="InstallLatest_Click" Visibility="Collapsed"/>
                        <Button x:Name="LatestSnapshot" Margin="0,0,8,8" Click="InstallLatest_Click" Visibility="Collapsed"/>
                        <Button Content="浏览全部版本" Style="{StaticResource Ghost}" Margin="0,0,0,8" Click="GoDownload_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== 当前版本 ===== -->
            <Border x:Name="InstanceCard" Style="{StaticResource CardBox}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="当前版本" Style="{StaticResource H2}"/>
                    <TextBlock x:Name="InstanceDesc" Style="{StaticResource Body}"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="打开游戏目录" Margin="0,0,8,8" Click="OpenGameDir_Click"/>
                        <Button Content="管理 Mod" Margin="0,0,8,8" Click="ManageMods_Click"/>
                        <Button Content="下载 Mod" Margin="0,0,0,8" Click="DownloadMods_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== 游戏运行中 ===== -->
            <Border x:Name="RunningCard" Style="{StaticResource CardBox}" Visibility="Collapsed" Margin="0,14,0,14">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="RunningTitle" Text="游戏运行中" Style="{StaticResource H2}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="打开游戏目录" Style="{StaticResource Ghost}" Click="OpenGameDir_Click"/>
                            <Button Content="结束游戏" Style="{StaticResource DangerButton}" Padding="12,5" Margin="6,0,0,0" Click="KillGame_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="GameLog" Margin="0,12,0,0" Height="190" IsReadOnly="True" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                             VerticalContentAlignment="Top" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             Background="#8C0E1420" Foreground="#E6EDF7" BorderBrush="#26000000" Padding="12,10"/>
                </StackPanel>
            </Border>

            <!-- ===== 我的世界黄历（MC百科） ===== -->
            <Border Style="{StaticResource CardBox}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="我的世界黄历" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="AlmanacStamp" Style="{StaticResource Sub}" Margin="10,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="AlmanacRefresh" Style="{StaticResource Ghost}" Content="刷新" HorizontalAlignment="Right" Click="AlmanacRefresh_Click"/>
                    </Grid>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 宜 -->
                        <Border Grid.Column="0" CornerRadius="12" Background="#121E9E57" Padding="14,12,14,3">
                            <StackPanel>
                                <TextBlock Text="宜" FontSize="14.5" FontWeight="SemiBold" Foreground="#1E9E57" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="GoodList" ItemTemplate="{StaticResource AlmanacRow}"/>
                            </StackPanel>
                        </Border>

                        <!-- 忌 -->
                        <Border Grid.Column="2" CornerRadius="12" Background="#12E03B3B" Padding="14,12,14,3">
                            <StackPanel>
                                <TextBlock Text="忌" FontSize="14.5" FontWeight="SemiBold" Foreground="#E03B3B" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="BadList" ItemTemplate="{StaticResource AlmanacRow}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="AlmanacHint" Style="{StaticResource Sub}" Margin="0,6,0,0" Visibility="Collapsed"/>

                    <Grid Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource Sub}" Opacity="0.75" VerticalAlignment="Center"
                                   Text="宜忌来自 MC百科「我的世界黄历」，每 3 小时自动更新一次，也可以手动刷新。"/>
                        <Button Style="{StaticResource Ghost}" Content="去百科看看" HorizontalAlignment="Right"
                                Padding="7,3" FontSize="11.5" Click="OpenAlmanac_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
