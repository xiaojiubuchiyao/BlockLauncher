<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =========================================================
         Apple / visionOS 风格：玻璃卡片 + 系统蓝 + 大圆角
         约定：所有页面只认资源键名，换肤只改这里。
         ========================================================= -->

    <!-- ========== 颜色（Accent 系列在运行时按主题色替换） ========== -->
    <Color x:Key="AccentColor">#0A7CFF</Color>
    <SolidColorBrush x:Key="Accent" Color="#0A7CFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#2C8CFF"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#0066DB"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#240A7CFF"/>
    <SolidColorBrush x:Key="AccentSoft2" Color="#3D0A7CFF"/>

    <!-- 底色：柔和的彩色网格，玻璃全靠它透出来 -->
    <LinearGradientBrush x:Key="Bg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E3EDFF" Offset="0"/>
        <GradientStop Color="#F5E9FF" Offset="0.48"/>
        <GradientStop Color="#DDF8EC" Offset="1"/>
    </LinearGradientBrush>

    <!-- 玻璃填充 -->
    <SolidColorBrush x:Key="Card" Color="#7AFFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#9AFFFFFF"/>
    <!-- 悬浮层（对话框 / 抽屉）：几乎不透明，避免底下内容透上来 -->
    <SolidColorBrush x:Key="Surface" Color="#F4F8FF"/>
    <SolidColorBrush x:Key="SurfaceStroke" Color="#DDE5F0"/>
    <SolidColorBrush x:Key="CardSolid" Color="#F7FAFF"/>
    <SolidColorBrush x:Key="Line" Color="#66FFFFFF"/>

    <SolidColorBrush x:Key="Text" Color="#131417"/>
    <SolidColorBrush x:Key="Text2" Color="#5A6270"/>
    <SolidColorBrush x:Key="Text3" Color="#8A92A0"/>

    <SolidColorBrush x:Key="Danger" Color="#E5484D"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#33E5484D"/>
    <SolidColorBrush x:Key="Ok" Color="#1FA55C"/>
    <SolidColorBrush x:Key="OkSoft" Color="#331FA55C"/>
    <SolidColorBrush x:Key="Warn" Color="#D98200"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#33D98200"/>

    <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>

    <CornerRadius x:Key="R">20</CornerRadius>

    <!-- 玻璃边缘：上亮下暗，模拟高光 -->
    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#4DFFFFFF" Offset="0.55"/>
        <GradientStop Color="#80FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="26" ShadowDepth="7" Direction="270" Opacity="0.15" Color="#122040" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.12" Color="#122040" RenderingBias="Performance"/>

    <!-- ========== 基础文字 ========== -->
    <Style TargetType="TextBlock" x:Key="H1">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="H2">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Sub">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Body">
        <Setter Property="FontSize" Value="12.8"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="21"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Icon">
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ========== 玻璃卡片 ========== -->
    <Style TargetType="Border" x:Key="CardBox">
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- 主视觉卡片（大一点、玻璃更实） -->
    <Style TargetType="Border" x:Key="HeroCard" BasedOn="{StaticResource CardBox}">
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="CornerRadius" Value="24"/>
    </Style>

    <!-- ========== 按钮 ========== -->
    <Style TargetType="Button" x:Key="BaseButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="15,7"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="{DynamicResource Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft2}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

    <!-- 主按钮：主题色 + 顶部高光 -->
    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.34" Color="{DynamicResource AccentColor}" RenderingBias="Performance"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="12" IsHitTestVisible="False" Background="{StaticResource GlassHighlight}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentPressed}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX" To="0.975" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY" To="0.975" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 无边框文字按钮 -->
    <Style TargetType="Button" x:Key="Ghost" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="Padding" Value="9,5"/>
    </Style>

    <!-- ========== 窗口按钮（Windows 惯例，右上角） ========== -->
    <Style TargetType="Button" x:Key="TitleIcon">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#14000000"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#24000000"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮：悬停变 Windows 红 -->
    <Style TargetType="Button" x:Key="CaptionClose" BasedOn="{StaticResource TitleIcon}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#9E2114"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 顶部胶囊导航 ========== -->
    <Style TargetType="RadioButton" x:Key="TopNav">
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="FontSize" Value="12.8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="999" Padding="14,6" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="navScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="12.5" VerticalAlignment="Center" Margin="0,1,7,0" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <!-- 按下时轻微回缩，松开弹回：点导航也有"按到了"的手感 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.09"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="navScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左侧子导航 -->
    <Style TargetType="RadioButton" x:Key="SideNav">
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="FontSize" Value="12.8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="11,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="13.5" VerticalAlignment="Center" Margin="0,1,9,0" Foreground="{TemplateBinding Foreground}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#40FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#D9FFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 胶囊单选（加载器选择、来源切换） -->
    <!-- 分段筛选：纯文字 + 选中下划线。不用色块，避免页面上出现一串胶囊 -->
    <Style TargetType="RadioButton" x:Key="SegTab">
        <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        <Setter Property="FontSize" Value="12.8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,18,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        <Border x:Name="u" Grid.Row="1" Height="2.5" CornerRadius="1.5" Margin="0,5,0,0"
                                Background="{DynamicResource Accent}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="u" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 开关（iOS 样式） -->
    <Style TargetType="CheckBox" x:Key="Switch">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="FontSize" Value="12.8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="track" Width="44" Height="26" CornerRadius="13" Background="#3D000000" VerticalAlignment="Center">
                            <Grid Margin="3">
                                <Ellipse x:Name="knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.22" Color="#000000"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 输入框 ========== -->
    <Style TargetType="TextBox">
        <Setter Property="FontSize" Value="12.8"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="#8CFFFFFF"/>
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Text3}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="b" Property="Background" Value="#E6FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#A6FFFFFF"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="12.8"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="BorderBrush" Value="#59FFFFFF"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" Background="#8CFFFFFF" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="11">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="b" Property="Background" Value="#E6FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 下拉框 ========== -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="b" Background="#8CFFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1" CornerRadius="11">
            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" Foreground="{DynamicResource Text3}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#A6FFFFFF"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="FontSize" Value="12.8"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter IsHitTestVisible="False" Margin="11,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="#F2FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="12" Margin="0,5,10,10"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Padding="5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#122040"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft2}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 列表项（玻璃卡片式可点击行） ========== -->
    <Style TargetType="ListBox" x:Key="CardList">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,0,7"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" CornerRadius="14" Padding="13,10">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#D9FFFFFF"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 进度条 ========== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="#33000000"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!-- ClipToBounds：任何越界位移都会被裁掉，不会再跑到轨道外面 -->
                    <Grid x:Name="TemplateRoot" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Track" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/>
                        <!-- 不确定态：一条按比例移动的高光，位移用 RelativeTransform，宽度多大都贴合轨道 -->
                        <Border x:Name="Indeterminate" CornerRadius="3" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.45,0">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform x:Name="ShineShift" X="-0.5"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#000A7CFF" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5"/>
                                    <GradientStop Color="#000A7CFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X"
                                                         From="-0.5" To="1.0" Duration="0:0:1.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 细滚动条 ========== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="t" Background="#33000000" CornerRadius="5" Margin="3,0"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="t" Property="Background" Value="#59000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#33000000" CornerRadius="5" Margin="0,3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#E6141517"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
